generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  WASHING
  DRYING
  IRONING
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ServiceType {
  KILOAN
  SATUAN
  EXPRESS
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  EWALLET
}

enum ExpenseCategory {
  BAHAN_BAKU
  UTILITAS
  GAJI
  ADMINISTRASI
  LAINNYA
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum NotificationType {
  STATUS_UPDATE
  PROMO
  BILLING
}

enum UserNotificationType {
  NEW_ORDER
  PAYMENT_CONFIRMED
  CUSTOMER_CHAT
}

enum SenderType {
  CUSTOMER
  STAFF
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  photoUrl  String?
  password  String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  resetToken       String?
  resetTokenExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]              @relation("CourierOrders")
  statusHistories OrderStatusHistory[]
  cannedHistories CannedQuestionHistory[]
  userNotifications UserNotification[]
  messages          Message[]
}

model Customer {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String   @unique
  email         String?
  password      String?
  address       String?
  totalOrders   Int      @default(0)
  totalWeight   Float    @default(0)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders          Order[]
  notifications   Notification[]
  cannedHistories CannedQuestionHistory[]
  conversations   Conversation[]
}

model Service {
  id          Int         @id @default(autoincrement())
  code        String      @unique
  name        String
  type        ServiceType @default(KILOAN)
  category    String?
  pricePerKg  Int?
  priceUnit   Int?
  description String?
  isActive    Boolean     @default(true)
  parentId    Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parent   Service?  @relation("ServiceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Service[] @relation("ServiceHierarchy")

  orders     Order[]
  orderItems OrderItem[]

  @@index([parentId])
  @@index([category])
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  trackingToken   String      @default(uuid()) @unique
  customerId      Int
  serviceId       Int
  weight          Float?
  itemCount       Int?
  totalPrice      Int
  status          OrderStatus @default(PENDING)
  pickupAddress   String?
  deliveryAddress String?
  pickupDate      DateTime?
  deliveryDate    DateTime?
  estimatedDone   DateTime?
  completedAt     DateTime?
  notes           String?
  courierId       Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service         Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  courier         User?                @relation("CourierOrders", fields: [courierId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistories OrderStatusHistory[]
  transaction     Transaction?
  notifications   Notification[]
  cannedHistories CannedQuestionHistory[]
  conversations   Conversation[]

  @@index([customerId, createdAt])
  @@index([serviceId])
  @@index([courierId])
  @@index([status, createdAt])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  serviceId  Int
  name       String
  weight     Float?
  itemCount  Int?
  unitPrice  Int
  subtotal   Int
  createdAt  DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([serviceId])
}

model Expense {
  id          Int             @id @default(autoincrement())
  category    ExpenseCategory @default(LAINNYA)
  amount      Int
  source      String?
  description String?
  receiptProof String?
  spentAt     DateTime        @default(now())
  createdBy   Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, spentAt])
  @@index([spentAt])
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  changedBy Int?
  notes     String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User? @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model Transaction {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique
  amount        Int
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  paymentProof  String?
  notes         String?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([paymentStatus, paidAt])
}

model Notification {
  id         Int              @id @default(autoincrement())
  customerId Int
  orderId    Int?
  type       NotificationType @default(STATUS_UPDATE)
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, isRead, createdAt])
  @@index([orderId])
}

model CannedQuestion {
  id        Int      @id @default(autoincrement())
  category  String   @default("GENERAL")
  question  String
  answer    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories CannedQuestionHistory[]

  @@index([category, isActive])
}

model CannedQuestionHistory {
  id               Int            @id @default(autoincrement())
  cannedQuestionId Int?
  userId           Int?
  customerId       Int?
  orderId          Int?
  questionText     String
  answerText       String
  userIp           String?
  createdAt        DateTime       @default(now())

  cannedQuestion CannedQuestion? @relation(fields: [cannedQuestionId], references: [id], onDelete: SetNull)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([cannedQuestionId])
  @@index([customerId])
}

model UserNotification {
  id        Int                  @id @default(autoincrement())
  userId    Int
  type      UserNotificationType @default(NEW_ORDER)
  title     String
  message   String
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Conversation {
  id         Int       @id @default(autoincrement())
  customerId Int
  orderId    Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([customerId, updatedAt])
  @@index([orderId])
}

model Message {
  id             Int        @id @default(autoincrement())
  conversationId Int
  senderType     SenderType
  senderUserId   Int?
  body           String
  createdAt      DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model LaundryProfile {
  id              Int      @id @default(autoincrement())
  name            String?
  address         String?
  info            String?
  operationalDays String[] @default([])
  openTime        String?
  closeTime       String?
  whatsapp        String?
  email           String?
  links           String?
  updatedAt       DateTime @updatedAt
}

model PaymentSetting {
  id               Int      @id @default(autoincrement())
  qrisEnabled      Boolean  @default(true)
  qrisMerchantName String?
  qrisNmid         String?
  qrisImageUrl     String?
  cashEnabled      Boolean  @default(true)
  transferEnabled  Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model BankAccount {
  id          Int      @id @default(autoincrement())
  bankName    String
  noRekening  String
  namaPemilik String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([enabled])
}

