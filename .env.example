# =============================================================================
# Cheva Laundry API — Contoh Environment
# -----------------------------------------------------------------------------
# Cara pakai:  cp .env.example .env  lalu isi nilainya.
# File .env TIDAK di-commit (lihat .gitignore). Jangan taruh secret asli di sini.
# Catatan: kalau jalan via Docker (docker compose), variabel di-inject dari
# docker-compose.yml — kamu tidak perlu file .env ini.
# =============================================================================

# === APP =====================================================================
# NODE_ENV : "development" (log verbose, error detail) atau "production".
# PORT     : port HTTP server. Default 8000. Health check: /api/health.
NODE_ENV=development
PORT=8000

# === DATABASE ================================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Password yang mengandung karakter spesial (mis. ! @ #) harus di-URL-encode.
#
# Buat dulu database-nya:  createdb tubes_cheva   (atau via psql / Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tubes_cheva"

# === JWT =====================================================================
# JWT_SECRET     : kunci penandatangan token. WAJIB diisi & rahasia.
#                  Generate acak:  npm run jwt:secret
#                  App menolak start kalau kosong / masih nilai contoh.
# JWT_EXPIRES_IN : masa berlaku token (mis. "7d", "24h", "30m").
JWT_SECRET=
JWT_EXPIRES_IN=7d

# === UPLOAD ==================================================================
# UPLOAD_DIR    : folder tujuan file upload (bukti bayar / nota). Relatif ke BE.
# MAX_FILE_SIZE : batas ukuran file dalam byte. 5242880 = 5 MB.
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# === DEVELOPMENT SEED ========================================================
# Dipakai `npm run prisma:seed` untuk membuat akun admin awal.
# SEED_ADMIN_PASSWORD wajib >= 12 karakter (validasi di prisma/seed.js).
# Ganti nilai ini sebelum dipakai di lingkungan nyata.
SEED_ADMIN_NAME="Admin Cheva Laundry"
SEED_ADMIN_EMAIL="admin@cheva.local"
SEED_ADMIN_PHONE="081234567890"
SEED_ADMIN_PASSWORD="admin12345678"
