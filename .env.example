# === APP ===
NODE_ENV=development
PORT=8000

# === DATABASE ===
# Opsi A - Postgres lokal
DATABASE_URL="postgresql://postgres:password@localhost:5432/tubes_cheva"
DIRECT_URL="postgresql://postgres:password@localhost:5432/tubes_cheva"

# Opsi B - Supabase
# DATABASE_URL = connection pooler, port 6543 (dipakai app saat runtime)
# DIRECT_URL   = direct connection, port 5432 (dipakai prisma migrate)
# Ambil dari Supabase Dashboard > Project Settings > Database > Connection string
# Pakai host *.pooler.supabase.com (db.<ref>.supabase.co cuma punya AAAA/IPv6).
# sslmode=require perlu; jangan pakai sslaccept=strict (cert verify gagal).
# connect_timeout dinaikkan karena default 5s sering timeout ke region jauh.
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&connect_timeout=30&pool_timeout=30"
# DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"

# === JWT ===
# Generate: npm run jwt:secret
JWT_SECRET=
JWT_EXPIRES_IN=7d

# === UPLOAD ===
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# === DEVELOPMENT SEED ===
SEED_ADMIN_NAME="Admin Cheva Laundry"
SEED_ADMIN_EMAIL="admin@cheva.local"
SEED_ADMIN_PHONE="081234567890"
SEED_ADMIN_PASSWORD="admin12345678"
