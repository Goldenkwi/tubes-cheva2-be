# =============================================================================
# Override environment untuk Docker Compose (BE + DB)
# -----------------------------------------------------------------------------
# SEMUA opsional — docker-compose.yml sudah punya default. File ini hanya perlu
# kalau kamu mau mengganti nilai default.
#
# Cara pakai:
#   cp .env.docker.example .env.docker   (lalu edit)
#   docker compose --env-file .env.docker up --build
#
# Atau langsung tanpa file:  docker compose up --build   (pakai default di bawah)
# =============================================================================

# Password superuser PostgreSQL di dalam container (dan bagian dari DATABASE_URL).
POSTGRES_PASSWORD=cheva_password

# Kunci penandatangan JWT. WAJIB diganti untuk penggunaan nyata.
# Generate acak:  openssl rand -hex 32
JWT_SECRET=cheva-default-jwt-secret-change-me

# Akun admin awal yang dibuat saat seed (login pertama kali).
# SEED_ADMIN_PASSWORD wajib >= 12 karakter.
SEED_ADMIN_NAME=Admin Cheva Laundry
SEED_ADMIN_EMAIL=admin@cheva.local
SEED_ADMIN_PHONE=081234567890
SEED_ADMIN_PASSWORD=admin12345678
